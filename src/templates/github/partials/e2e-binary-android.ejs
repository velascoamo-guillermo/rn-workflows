<%#
  Android e2e test binary: assembleRelease APK (Expo's template signs release
  with the debug keystore) whose expo-updates config points at the staging
  channel, cached by runtimeVersion at $RUNNER_TEMP/rnw-e2e/android/app.apk.
  The store binary is never patched: the manifest is restored right after
  on the native path (the OTA path never builds a store binary).
  Locals: e2e (view from github-actions.ts), expoCli, projectType, hashExpr,
  restore (bool: OTA path restores/saves the cache and skips the build on a
  hit; the native path always builds fresh and saves after its flows pass),
  idPrefix (step id prefix), gate (bare `if:` condition ANDed into every step).
-%>
<% const buildIf = joinIf(gate, restore && `steps.${idPrefix}e2e-cache.outputs.cache-hit != 'true'`); -%>
<% if (restore) { -%>
      - name: Restore e2e test binary (android)
        id: <%= idPrefix %>e2e-cache
<% if (gate) { -%>
        if: <%- gate %>
<% } -%>
        uses: actions/cache/restore@v4
        with:
          path: ${{ runner.temp }}/rnw-e2e/android
          key: <%- e2e.cacheKey %>

<% } -%>
<% if (projectType === 'expo') { -%>
      - name: Prebuild native project for e2e (android)
        id: <%= idPrefix %>e2e-prebuild
<% if (buildIf) { -%>
        if: <%- buildIf %>
<% } -%>
        env:
          RNW_PLATFORM: android
        run: <%- expoCli %> prebuild --platform "$RNW_PLATFORM" --clean

<% } -%>
      - name: Point test binary at the staging channel (android)
        id: <%= idPrefix %>e2e-patch
<% if (buildIf) { -%>
        if: <%- buildIf %>
<% } -%>
        env:
          RNW_STAGING_CHANNEL: <%- e2e.stagingChannel %>
        run: |
          set -euo pipefail
          MANIFEST=android/app/src/main/AndroidManifest.xml
          mkdir -p "$RUNNER_TEMP/rnw-e2e-orig"
          cp "$MANIFEST" "$RUNNER_TEMP/rnw-e2e-orig/AndroidManifest.xml"
          cat > "$RUNNER_TEMP/rnw-patch-manifest.js" <<'JS'
          const fs = require("fs");
          const file = process.argv[2];
          let xml = fs.readFileSync(file, "utf8");
          function setMeta(name, value) {
            const tag = '<meta-data android:name="' + name + '" android:value="' + value + '"/>';
            const re = new RegExp('<meta-data\\b[^>]*android:name="' + name.replace(/\./g, "\\.") + '"[^>]*/>');
            if (re.test(xml)) xml = xml.replace(re, tag);
            else if (xml.includes("</application>")) xml = xml.replace("</application>", "  " + tag + "\n    </application>");
            else throw new Error("no <application> element in " + file);
          }
          const headers = JSON.stringify({ "expo-channel-name": process.env.RNW_STAGING_CHANNEL }).replace(/"/g, "&quot;");
          setMeta("expo.modules.updates.UPDATES_CONFIGURATION_REQUEST_HEADERS_KEY", headers);
          setMeta("expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS", "30000");
          fs.writeFileSync(file, xml);
          JS
          node "$RUNNER_TEMP/rnw-patch-manifest.js" "$MANIFEST"

<% if (setupJava) { -%>
      - name: Setup JDK
<% if (buildIf) { -%>
        if: <%- buildIf %>
<% } -%>
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

<% } -%>
      - name: Build e2e test binary (android release apk)
        id: <%= idPrefix %>e2e-build
<% if (buildIf) { -%>
        if: <%- buildIf %>
<% } -%>
        env:
          EXPO_UPDATES_FINGERPRINT_OVERRIDE: <%- hashExpr %>
          GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g"
        run: |
          set -euo pipefail
          (cd android && ./gradlew assembleRelease)
          OUT="$RUNNER_TEMP/rnw-e2e/android"
          rm -rf "$OUT"
          mkdir -p "$OUT"
          cp android/app/build/outputs/apk/release/app-release.apk "$OUT/app.apk"

<% if (restore) { -%>
<%- include('e2e-save-step', { platform: 'android' }) -%>
<% } -%>
<% if (!restore) { -%>
      - name: Restore native project after the test build (android)
        id: <%= idPrefix %>e2e-unpatch
<% if (buildIf) { -%>
        if: <%- buildIf %>
<% } -%>
<% if (projectType === 'expo') { -%>
        run: cp "$RUNNER_TEMP/rnw-e2e-orig/AndroidManifest.xml" android/app/src/main/AndroidManifest.xml
<% } else { -%>
        run: git checkout -- android
<% } -%>

<% } -%>
