<%#
  Save the e2e test binary under its cache key. Locals: platform, e2e, restore
  (true: skip when the restore step hit), idPrefix, gate.
-%>
<% const saveIf = joinIf(gate, restore && `steps.${idPrefix}e2e-cache.outputs.cache-hit != 'true'`); -%>
      - name: Save e2e test binary (<%= platform %>)
        id: <%= idPrefix %>e2e-save
<% if (saveIf) { -%>
        if: <%- saveIf %>
<% } -%>
        uses: actions/cache/save@v4
        with:
          path: ${{ runner.temp }}/rnw-e2e/<%= platform %>
          key: <%- e2e.cacheKey %>

