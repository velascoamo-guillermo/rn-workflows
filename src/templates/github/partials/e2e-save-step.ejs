<%#
  Save the e2e test binary under its cache key. Locals: platform, e2e, restore
  (true: skip when the restore step hit).
-%>
      - name: Save e2e test binary (<%= platform %>)
        id: e2e-save
<% if (restore) { -%>
        if: steps.e2e-cache.outputs.cache-hit != 'true'
<% } -%>
        uses: actions/cache/save@v4
        with:
          path: ${{ runner.temp }}/rnw-e2e/<%= platform %>
          key: <%- e2e.cacheKey %>

