<%#
  Maestro on an iOS simulator: pinned conditional install, boot + install the
  cached test binary, then (OTA path only) the update-id guard flow before the
  user's flows.
  Locals: e2e (view from github-actions.ts), guard (bool), maestroVersion,
  idPrefix (this partial's step ids), pkgPrefix (id prefix of the update-id
  step), gate (bare `if:` condition or '').
-%>
<%- include('maestro-install-step') -%>
      - name: Boot simulator and install test binary
        id: <%= idPrefix %>simulator
<% if (gate) { -%>
        if: <%- gate %>
<% } -%>
<% if (e2e.iosDevice) { -%>
        env:
          RNW_IOS_DEVICE: <%- e2e.iosDevice %>
<% } -%>
        run: |
          set -euo pipefail
          if [ -n "${RNW_IOS_DEVICE:-}" ]; then
            UDID=$(xcrun simctl list devices available -j | jq -er --arg name "$RNW_IOS_DEVICE" '[.devices[][] | select(.name == $name)][0].udid')
          else
            UDID=$(xcrun simctl list devices available -j | jq -er '[.devices[][] | select(.name | startswith("iPhone"))][0].udid')
          fi
          xcrun simctl bootstatus "$UDID" -b
          xcrun simctl install "$UDID" "$RUNNER_TEMP/rnw-e2e/ios/app.app"
          echo "udid=$UDID" >> "$GITHUB_OUTPUT"

<% if (guard) { -%>
<%- include('guard-flow-step') -%>
<% } -%>
      - name: Run Maestro flows (ios)
        id: <%= idPrefix %>maestro
<% if (gate) { -%>
        if: <%- gate %>
<% } -%>
        env:
          RNW_UDID: ${{ steps.<%= idPrefix %>simulator.outputs.udid }}
          RNW_APP_ID: <%- e2e.appId %>
          RNW_FLOWS: <%- e2e.flows %>
<% if (guard) { -%>
          RNW_EXPECTED_UPDATE_ID: ${{ steps.<%= pkgPrefix %>update-id.outputs.update_id }}
<% } -%>
        run: |
          set -euo pipefail
<% if (guard) { -%>
          maestro --device "$RNW_UDID" test -e "RNW_APP_ID=$RNW_APP_ID" -e "RNW_EXPECTED_UPDATE_ID=$RNW_EXPECTED_UPDATE_ID" "$RUNNER_TEMP/rnw-assert-update.yaml"
          maestro --device "$RNW_UDID" test -e "RNW_EXPECTED_UPDATE_ID=$RNW_EXPECTED_UPDATE_ID" "./$RNW_FLOWS"
<% } else { -%>
          maestro --device "$RNW_UDID" test "./$RNW_FLOWS"
<% } -%>

