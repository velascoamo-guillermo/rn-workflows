<%#
  POST bundle.zip to the OTA server. Every value reaches the shell via env;
  --form-string keeps user strings literal (no curl @file / <file reads);
  the upload key goes through stdin so it never appears in curl's argv.
  Locals: otaServer, otaChannel, hashExpr (YAML-rendered values); optional
  stepId (default "upload") and stepName (default "Upload OTA update").
-%>
      - name: <%- typeof stepName !== 'undefined' ? stepName : 'Upload OTA update' %>
        id: <%= typeof stepId !== 'undefined' ? stepId : 'upload' %>
        env:
          RNW_OTA_SERVER: <%- otaServer %>
          RNW_CHANNEL: <%- otaChannel %>
          RNW_HASH: <%- hashExpr %>
          RNW_COMMIT_MESSAGE: ${{ github.event.head_commit.message }}
          OTA_UPLOAD_KEY: ${{ secrets.OTA_UPLOAD_KEY }}
        run: |
          set -euo pipefail
          printf '%s' "$OTA_UPLOAD_KEY" | curl --fail-with-body -sS --connect-timeout 30 --max-time 600 \
            -X POST "$RNW_OTA_SERVER/api/upload" \
            -F "file=@bundle.zip" \
            --form-string "runtimeVersion=$RNW_HASH" \
            --form-string "channel=$RNW_CHANNEL" \
            --form-string "commitHash=$GITHUB_SHA" \
            --form-string "commitMessage=$RNW_COMMIT_MESSAGE" \
            -F "uploadKey=<-"

