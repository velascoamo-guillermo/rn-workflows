# Auto-generated by rn-workflows. Do not edit by hand.
# Regenerate with: npx rn-workflows generate --matrix
#
# One matrix workflow for every app in this monorepo. Deliberately NOT
# triggered by on.push.paths: a path filter cannot scope matrix legs, so any
# app's change would rebuild all apps. Release via tag push or dispatch.

name: rn-workflows • release matrix

on:
  workflow_dispatch:
    inputs:
      app:
        description: Only run for this app slug (empty = all apps)
        type: string
        required: false
        default: ''
  push:
    tags:
      - 'v*'

jobs:
  plan:
    name: Plan matrix
    runs-on: ubuntu-latest
    env:
      QUALITY_LEGS: <%- JSON.stringify(qualityLegsJson) %>
      RELEASE_LEGS: <%- JSON.stringify(releaseLegsJson) %>
      APP_FILTER: ${{ inputs.app || '' }}
    outputs:
      quality: ${{ steps.plan.outputs.quality }}
      release: ${{ steps.plan.outputs.release }}
    steps:
      - name: Filter matrix legs by app input
        id: plan
        run: |
          if [ -n "$APP_FILTER" ]; then
            QUALITY=$(echo "$QUALITY_LEGS" | jq -c --arg app "$APP_FILTER" '[.[] | select(.app == $app)]')
            RELEASE=$(echo "$RELEASE_LEGS" | jq -c --arg app "$APP_FILTER" '[.[] | select(.app == $app)]')
          else
            QUALITY=$(echo "$QUALITY_LEGS" | jq -c .)
            RELEASE=$(echo "$RELEASE_LEGS" | jq -c .)
          fi
          echo "quality=$QUALITY" >> "$GITHUB_OUTPUT"
          echo "release=$RELEASE" >> "$GITHUB_OUTPUT"

  quality:
    name: Quality (${{ matrix.app }})
    needs: plan
    if: ${{ needs.plan.outputs.quality != '[]' }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.plan.outputs.quality) }}
    defaults:
      run:
        working-directory: ${{ matrix.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
<% if (packageManager !== 'bun') { -%>
          cache: <%= packageManager %>
<% } -%>

<% if (packageManager === 'bun') { -%>
      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

<% } -%>
      - name: Install JS dependencies
        run: <%= packageManager === 'bun' ? 'bun install --frozen-lockfile' : packageManager === 'npm' ? 'npm ci' : 'yarn install --frozen-lockfile' %>

      - name: Lint
        if: ${{ matrix.lint }}
        run: <%= packageManager === 'bun' ? 'bun expo lint' : packageManager === 'npm' ? 'npx expo lint' : 'yarn expo lint' %>

      - name: Type check
        if: ${{ matrix.typecheck }}
        run: <%= packageManager === 'bun' ? 'bun tsc --noEmit' : packageManager === 'npm' ? 'npx tsc --noEmit' : 'yarn tsc --noEmit' %>

      - name: Test
        if: ${{ matrix.test }}
        run: <%= packageManager === 'bun' ? 'bun test' : packageManager === 'npm' ? 'npm test' : 'yarn test' %>

  release:
    name: Release ${{ matrix.app }} ${{ matrix.profile }} (${{ matrix.platform }})
    needs: [plan, quality]
    if: ${{ !failure() && !cancelled() && needs.plan.outputs.release != '[]' }}
    runs-on: ${{ matrix.runsOn }}
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.plan.outputs.release) }}
    defaults:
      run:
        working-directory: ${{ matrix.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
<% if (packageManager !== 'bun') { -%>
          cache: <%= packageManager %>
<% } -%>

<% if (packageManager === 'bun') { -%>
      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

<% } -%>
      - name: Install JS dependencies
        run: <%= packageManager === 'bun' ? 'bun install --frozen-lockfile' : packageManager === 'npm' ? 'npm ci' : 'yarn install --frozen-lockfile' %>

<% if (hasOta) { -%>
      - name: Compute fingerprint
        if: ${{ matrix.ota }}
        id: fp
        run: |
          HASH=$(npx --yes @expo/fingerprint . 2>/dev/null)
          echo "hash=$HASH" >> $GITHUB_OUTPUT

      - name: Check if native binary exists for this fingerprint
        if: ${{ matrix.ota }}
        id: fp-cache
        uses: actions/cache@v4
        with:
          key: fingerprint-${{ matrix.app }}-${{ matrix.profile }}-${{ steps.fp.outputs.hash }}
          path: ${{ matrix.dir }}/.rn-fingerprint
          lookup-only: true

<%# OTA upload runs once per app; platform:all exports a universal bundle,
    so only the single leg flagged otaUpload (the cheapest one) exports and
    uploads it. Fingerprint steps above stay per-leg (matrix.ota) so every
    platform can still skip its native build on a cache hit. -%>
      - name: Export JS bundle (OTA)
        if: ${{ matrix.otaUpload && steps.fp-cache.outputs.cache-hit == 'true' }}
        run: npx expo export --platform all --output-dir dist

      - name: Package bundle (OTA)
        if: ${{ matrix.otaUpload && steps.fp-cache.outputs.cache-hit == 'true' }}
        run: cd dist && zip -r ../bundle.zip .

      - name: Upload OTA update
        if: ${{ matrix.otaUpload && steps.fp-cache.outputs.cache-hit == 'true' }}
        run: |
          curl -X POST ${{ matrix.otaServer }}/api/upload \
            -F "file=@bundle.zip" \
            -F "runtimeVersion=${{ steps.fp.outputs.hash }}" \
            -F "channel=${{ matrix.otaChannel }}" \
            -F "commitHash=${{ github.sha }}" \
            -F "uploadKey=${{ secrets.OTA_UPLOAD_KEY }}"

<% } -%>
<% const skipHit = hasOta ? " && steps.fp-cache.outputs.cache-hit != 'true'" : ''; -%>
      - name: Setup Ruby
<% if (hasOta) { -%>
        if: ${{ steps.fp-cache.outputs.cache-hit != 'true' }}
<% } -%>
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.2
          bundler-cache: true
          working-directory: ${{ matrix.dir }}

      - name: Select Xcode
        if: ${{ matrix.platform == 'ios'<%- skipHit %> }}
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

      - name: Setup JDK
        if: ${{ matrix.platform == 'android'<%- skipHit %> }}
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Expo Prebuild (iOS)
        if: ${{ matrix.platform == 'ios'<%- skipHit %> }}
        run: npx expo prebuild --platform ios --no-install

      - name: Install Pods
        if: ${{ matrix.platform == 'ios'<%- skipHit %> }}
        run: cd ios && pod install --repo-update

      - name: Expo Prebuild (Android)
        if: ${{ matrix.platform == 'android'<%- skipHit %> }}
        run: npx expo prebuild --platform android --no-install

      - name: Run Fastlane lane
<% if (hasOta) { -%>
        if: ${{ steps.fp-cache.outputs.cache-hit != 'true' }}
<% } -%>
        run: bundle exec fastlane ${{ matrix.platform }} ${{ matrix.profile }}
        env:
<% for (const secret of secrets) { -%>
          <%= secret %>: ${{ secrets.<%= secret %> }}
<% } -%>
<% if (matchAuth) { -%>
          MATCH_GIT_BASIC_AUTHORIZATION: ${{ secrets.MATCH_GIT_BASIC_AUTHORIZATION }}
<% } -%>
          GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g"
<% if (hasOta) { -%>

      - name: Save fingerprint marker
        if: ${{ matrix.ota && steps.fp-cache.outputs.cache-hit != 'true' }}
        run: mkdir -p .rn-fingerprint && echo "${{ steps.fp.outputs.hash }}" > .rn-fingerprint/hash

      - name: Save fingerprint to cache
        if: ${{ matrix.ota && steps.fp-cache.outputs.cache-hit != 'true' }}
        uses: actions/cache/save@v4
        with:
          key: fingerprint-${{ matrix.app }}-${{ matrix.profile }}-${{ steps.fp.outputs.hash }}
          path: ${{ matrix.dir }}/.rn-fingerprint
<% } -%>
