# Auto-generated by rn-workflows. Do not edit by hand.
# Regenerate with: npx rn-workflows generate --matrix
#
# One matrix workflow for every app in this monorepo.
# - push to an OTA profile's branch: the plan job selects only the OTA legs
#   whose app dir / ci.extraPaths / this workflow changed since the previous
#   push (all of them when that base is unknown). Non-OTA legs never run on push.
# - tag push (v*): every leg. workflow_dispatch: every leg, or one app.
# - plan resolves each OTA leg's per-platform runtimeVersion and routes it:
#   native release tag already on origin -> ota matrix (JS-only update),
#   otherwise -> native matrix (store lane, then tag).

name: rn-workflows • release matrix

on:
  workflow_dispatch:
    inputs:
      app:
        description: Only run for this app slug (empty = all apps)
        type: string
        required: false
        default: ''
  push:
    branches: [<%- branches.join(', ') %>]
    tags:
      - 'v*'

permissions:
  contents: read

jobs:
  plan:
    name: Plan matrix
    runs-on: ubuntu-latest
    env:
      QUALITY_LEGS: <%- JSON.stringify(qualityLegsJson) %>
      RELEASE_LEGS: <%- JSON.stringify(releaseLegsJson) %>
    outputs:
      quality: ${{ steps.select.outputs.quality }}
      ota: ${{ steps.route.outputs.ota }}
      native: ${{ steps.route.outputs.native }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Select legs (changed paths, tag, or dispatch filter)
        id: select
        env:
          APP_FILTER: ${{ inputs.app || '' }}
          RNW_BEFORE: ${{ github.event.before }}
        run: |
          set -euo pipefail
          ZERO=0000000000000000000000000000000000000000
          if [ "$GITHUB_EVENT_NAME" = "push" ] && [ "$GITHUB_REF_TYPE" = "branch" ]; then
            CHANGED_FILE=$(mktemp)
            if [ -z "$RNW_BEFORE" ] || [ "$RNW_BEFORE" = "$ZERO" ] || ! git cat-file -e "$RNW_BEFORE^{commit}" 2>/dev/null; then
              echo "::notice::No usable push base ($RNW_BEFORE); selecting every OTA leg on $GITHUB_REF_NAME"
              ALL=true
            else
              git diff --name-only "$RNW_BEFORE" "$GITHUB_SHA" > "$CHANGED_FILE"
              ALL=false
            fi
            SELECTED=$(jq -c --arg branch "$GITHUB_REF_NAME" --argjson all "$ALL" --rawfile changed "$CHANGED_FILE" '
              ($changed | split("\n") | map(select(length > 0))) as $files
              | [.[] | select(.ota and .branch == $branch)
                | select($all or ([.paths[] as $p | $files[] | select($p == "" or startswith($p))] | length > 0))]
            ' <<< "$RELEASE_LEGS")
          elif [ "$GITHUB_EVENT_NAME" = "workflow_dispatch" ] && [ -n "$APP_FILTER" ]; then
            SELECTED=$(jq -c --arg app "$APP_FILTER" '[.[] | select(.app == $app)]' <<< "$RELEASE_LEGS")
          else
            SELECTED=$(jq -c . <<< "$RELEASE_LEGS")
          fi
          APPS=$(jq -c '[.[].app] | unique' <<< "$SELECTED")
          QUALITY=$(jq -c --argjson apps "$APPS" '[.[] | select(.app as $a | any($apps[]; . == $a))]' <<< "$QUALITY_LEGS")
          HAS_OTA=$(jq -r 'any(.[]; .ota)' <<< "$SELECTED")
          {
            echo "selected=$SELECTED"
            echo "quality=$QUALITY"
            echo "has_ota=$HAS_OTA"
          } >> "$GITHUB_OUTPUT"

      - name: Setup Node
        if: steps.select.outputs.has_ota == 'true'
        uses: actions/setup-node@v4
        with:
          node-version: 20

<% if (packageManager === 'bun') { -%>
      - name: Setup Bun
        if: steps.select.outputs.has_ota == 'true'
        uses: oven-sh/setup-bun@v2

<% } -%>
      - name: Route OTA legs by native release tag
        id: route
        env:
          RNW_SELECTED: ${{ steps.select.outputs.selected }}
        run: |
          set -euo pipefail
          SAFE='^[A-Za-z0-9._-]+$'
          OTA_FILE=$(mktemp)
          NATIVE_FILE=$(mktemp)
          INSTALLED_FILE=$(mktemp)
          jq -c '.[] | select(.ota | not)' <<< "$RNW_SELECTED" > "$NATIVE_FILE"
          while IFS= read -r LEG <&3; do
            DIR=$(jq -r '.dir' <<< "$LEG")
            PLATFORM=$(jq -r '.platform' <<< "$LEG")
            TAG_PREFIX=$(jq -r '.tagPrefix' <<< "$LEG")
            if ! grep -Fxq -- "$DIR" "$INSTALLED_FILE"; then
              (cd "$DIR" && <%- installCommand %>)
              printf '%s\n' "$DIR" >> "$INSTALLED_FILE"
            fi
            HASH=$(
              cd "$DIR"
              while IFS= read -r KV; do export "${KV?}"; done < <(jq -r '.env | fromjson | to_entries[] | "\(.key)=\(.value)"' <<< "$LEG")
              node "$(node -p "require.resolve('expo-updates/bin/cli.js')")" runtimeversion:resolve --platform "$PLATFORM" | tail -n1 | jq -er '.runtimeVersion'
            ) || HASH=""
            if [[ ! "$HASH" =~ $SAFE ]]; then
              echo "::error::runtimeVersion for $DIR ($PLATFORM) is missing or unsafe; set runtimeVersion: { policy: \"fingerprint\" } in app config"
              exit 1
            fi
            rc=0
            git ls-remote --exit-code --tags origin "refs/tags/$TAG_PREFIX/$HASH" > /dev/null || rc=$?
            case "$rc" in
              0) jq -c --arg hash "$HASH" '. + {hash: $hash}' <<< "$LEG" >> "$OTA_FILE" ;;
              2) jq -c --arg hash "$HASH" '. + {hash: $hash}' <<< "$LEG" >> "$NATIVE_FILE" ;;
              *) echo "::error::git ls-remote origin failed (exit $rc)"; exit "$rc" ;;
            esac
          done 3< <(jq -c '.[] | select(.ota)' <<< "$RNW_SELECTED")
          COLLIDING=$(jq -rs '
            [.[] | select(.hash != null)] | group_by([.app, .profile])
            | map(select((map(.hash) | unique | length) < length) | "\(.[0].app)/\(.[0].profile)")
            | join(", ")
          ' "$OTA_FILE" "$NATIVE_FILE")
          if [ -n "$COLLIDING" ]; then
            echo "::error::$COLLIDING: every platform resolved the same runtimeVersion; per-platform OTA uploads would collide on the server. Use runtimeVersion: { policy: \"fingerprint\" } in app config"
            exit 1
          fi
          {
            echo "ota=$(jq -sc . "$OTA_FILE")"
            echo "native=$(jq -sc . "$NATIVE_FILE")"
          } >> "$GITHUB_OUTPUT"

  quality:
    name: Quality (${{ matrix.app }})
    needs: plan
    if: ${{ needs.plan.outputs.quality != '[]' }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.plan.outputs.quality) }}
    defaults:
      run:
        working-directory: ${{ matrix.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

<%- include('partials/matrix-js-setup') -%>
      - name: Lint
        if: ${{ matrix.lint }}
        run: <%= packageManager === 'bun' ? 'bun expo lint' : packageManager === 'npm' ? 'npx expo lint' : 'yarn expo lint' %>

      - name: Type check
        if: ${{ matrix.typecheck }}
        run: <%= packageManager === 'bun' ? 'bun tsc --noEmit' : packageManager === 'npm' ? 'npx tsc --noEmit' : 'yarn tsc --noEmit' %>

      - name: Test
        if: ${{ matrix.test }}
        run: <%= packageManager === 'bun' ? 'bun test' : packageManager === 'npm' ? 'npm test' : 'yarn test' %>

  ota:
    name: OTA update ${{ matrix.app }} ${{ matrix.profile }} (${{ matrix.platform }})
    needs: [plan, quality]
    if: ${{ !failure() && !cancelled() && needs.plan.outputs.ota != '[]' }}
    runs-on: ${{ matrix.runsOn }}
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.plan.outputs.ota) }}
    concurrency:
      group: ${{ matrix.group }}
      cancel-in-progress: false
    defaults:
      run:
        working-directory: ${{ matrix.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

<%- include('partials/matrix-ci-env-step') -%>
<%- include('partials/matrix-js-setup') -%>
<%- include('partials/ota-package-steps', { platform: '${{ matrix.platform }}' }) -%>
<%# RW-8 (#54): when matrix.e2e, upload to matrix.stagingChannel, restore/build the
    e2e binary (partials/e2e-binary-*), run partials/maestro-* with the guard,
    then promote — the upload below becomes the e2e-less branch. -%>
<%- include('partials/ota-upload-step', { otaServer: '${{ matrix.otaServer }}', otaChannel: '${{ matrix.otaChannel }}', hashExpr: '${{ matrix.hash }}' }) -%>
  native:
    name: Release ${{ matrix.app }} ${{ matrix.profile }} (${{ matrix.platform }})
    needs: [plan, quality]
    if: ${{ !failure() && !cancelled() && needs.plan.outputs.native != '[]' }}
    runs-on: ${{ matrix.runsOn }}
    permissions:
      contents: write
    strategy:
      fail-fast: false
<% if (maxParallelOne) { -%>
      # fastlane match: one signing run at a time across apps.
      max-parallel: 1
<% } -%>
      matrix:
        include: ${{ fromJSON(needs.plan.outputs.native) }}
    concurrency:
      group: ${{ matrix.group }}
      cancel-in-progress: false
    defaults:
      run:
        working-directory: ${{ matrix.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

<%- include('partials/matrix-ci-env-step') -%>
