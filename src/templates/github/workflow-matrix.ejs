        run: echo "EXPO_UPDATES_FINGERPRINT_OVERRIDE=$RNW_HASH" >> "$GITHUB_ENV"

<%- include('partials/matrix-js-setup') -%>
<% if (hasSelfHosted) { -%>
      - name: Install Ruby dependencies
        if: ${{ matrix.selfHosted }}
        run: bundle install

<% } -%>
      - name: Setup Ruby
<% if (hasSelfHosted) { -%>
        if: ${{ !matrix.selfHosted }}
<% } -%>
        uses: ruby/setup-ruby@v1
        with:
