# Auto-generated by rn-workflows. Do not edit by hand.
# Regenerate with: npx rn-workflows generate

name: <%- yamlScalar(workflowName) %>

on:
  workflow_dispatch:
  push:
    branches: [<%= branch %>]
<% if (appDir) { -%>
    paths:
      - '<%- yamlSingleQuoted(appDir) %>/**'
<% for (const extraPath of extraPaths) { -%>
      - '<%- yamlSingleQuoted(extraPath) %>'
<% } -%>
      - '<%- yamlSingleQuoted(selfPath) %>'
<% } -%>

permissions:
  contents: read

jobs:
<% if (hasChecks) { -%>
  quality:
    name: Quality checks
    runs-on: ubuntu-latest
<% if (appDir) { -%>
    defaults:
      run:
        working-directory: <%- yamlScalar(appDir) %>
<% } -%>
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
<% if (packageManager !== 'bun') { -%>
          cache: <%= packageManager %>
<% if (appDir) { -%>
          cache-dependency-path: <%- yamlScalar(`${appDir}/${packageManager === 'npm' ? 'package-lock.json' : 'yarn.lock'}`) %>
<% } -%>
<% } -%>

<% if (packageManager === 'bun') { -%>
      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

<% } -%>
      - name: Install JS dependencies
        run: <%= packageManager === 'bun' ? 'bun install --frozen-lockfile' : packageManager === 'npm' ? 'npm ci' : 'yarn install --frozen-lockfile' %>

<% if (checks.lint) { -%>
      - name: Lint
        run: <%= packageManager === 'bun' ? 'bun expo lint' : packageManager === 'npm' ? 'npx expo lint' : 'yarn expo lint' %>

<% } -%>
<% if (checks.typecheck) { -%>
      - name: Type check
        run: <%= packageManager === 'bun' ? 'bun tsc --noEmit' : packageManager === 'npm' ? 'npx tsc --noEmit' : 'yarn tsc --noEmit' %>

<% } -%>
<% if (checks.test) { -%>
      - name: Test
        run: <%= packageManager === 'bun' ? 'bun test' : packageManager === 'npm' ? 'npm test' : 'yarn test' %>

<% } -%>
<% } -%>
  fingerprint:
    name: Compute fingerprint
    runs-on: ubuntu-latest
<% if (hasChecks) { -%>
    needs: quality
<% } -%>
<% if (appDir) { -%>
    defaults:
      run:
        working-directory: <%- yamlScalar(appDir) %>
<% } -%>
    outputs:
<% for (const job of jobs) { -%>
      <%= job.platform %>_hash: ${{ steps.fp-<%= job.platform %>.outputs.hash }}
      <%= job.platform %>_native_exists: ${{ steps.native-<%= job.platform %>.outputs.exists }}
<% } -%>
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
<% if (packageManager !== 'bun') { -%>
          cache: <%= packageManager %>
<% if (appDir) { -%>
          cache-dependency-path: <%- yamlScalar(`${appDir}/${packageManager === 'npm' ? 'package-lock.json' : 'yarn.lock'}`) %>
<% } -%>
<% } -%>

<% if (packageManager === 'bun') { -%>
      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

<% } -%>
      - name: Install JS dependencies
        run: <%= packageManager === 'bun' ? 'bun install --frozen-lockfile' : packageManager === 'npm' ? 'npm ci' : 'yarn install --frozen-lockfile' %>

<% for (const job of jobs) { -%>
<%- include('partials/fingerprint-steps', { platform: job.platform, tagPrefix: job.tagPrefix }) -%>
<% } -%>
<% if (jobs.length > 1) { -%>
      - name: Require distinct per-platform runtimeVersions
        id: fp-distinct
        env:
          RNW_IOS_HASH: ${{ steps.fp-ios.outputs.hash }}
          RNW_ANDROID_HASH: ${{ steps.fp-android.outputs.hash }}
        run: |
          set -euo pipefail
          if [ "$RNW_IOS_HASH" = "$RNW_ANDROID_HASH" ]; then
            echo "::error::ios and android resolved the same runtimeVersion ($RNW_IOS_HASH); per-platform OTA uploads would collide on the server. Use runtimeVersion: { policy: \"fingerprint\" } in app config"
            exit 1
          fi

<% } -%>
<% for (const job of jobs) { -%>
  ota-<%= job.platform %>:
    name: <%- yamlScalar(`OTA update ${job.lane} (${job.platform})`) %>
    runs-on: <%- job.runsOn %>
<% if (job.env.length > 0) { -%>
    env:
<% for (const e of job.env) { -%>
      <%= e.key %>: <%- e.value %>
<% } -%>
<% } -%>
    needs: fingerprint
    if: needs.fingerprint.outputs.<%= job.platform %>_native_exists == 'true'
    concurrency:
      group: <%- job.concurrencyGroup %>
      cancel-in-progress: false
<% if (appDir) { -%>
    defaults:
      run:
        working-directory: <%- yamlScalar(appDir) %>
<% } -%>
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
<% if (packageManager !== 'bun') { -%>
          cache: <%= packageManager %>
<% if (appDir) { -%>
          cache-dependency-path: <%- yamlScalar(`${appDir}/${packageManager === 'npm' ? 'package-lock.json' : 'yarn.lock'}`) %>
<% } -%>
<% } -%>

<% if (packageManager === 'bun') { -%>
      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

<% } -%>
      - name: Install JS dependencies
        run: <%= packageManager === 'bun' ? 'bun install --frozen-lockfile' : packageManager === 'npm' ? 'npm ci' : 'yarn install --frozen-lockfile' %>

<%- include('partials/ota-package-steps', { platform: job.platform }) -%>
<% if (job.e2e) { -%>
<%- include('partials/ota-upload-step', { stepId: 'upload-staging', stepName: 'Upload OTA update to staging channel', otaChannel: job.e2e.stagingChannel, hashExpr: job.hashExpr }) -%>
<% if (job.platform === 'ios' && !job.selfHosted) { -%>
      - name: Select Xcode
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

<% } -%>
<%- include(`partials/e2e-binary-${job.platform}`, { e2e: job.e2e, hashExpr: job.hashExpr, setupJava: true, restore: true }) -%>
<%- include(`partials/maestro-${job.platform}`, { e2e: job.e2e, guard: true, selfHosted: job.selfHosted }) -%>
<%- include('partials/ota-upload-step', { stepId: 'promote', stepName: 'Promote OTA update to production channel', hashExpr: job.hashExpr }) -%>
<% } else { -%>
<%- include('partials/ota-upload-step', { hashExpr: `\${{ needs.fingerprint.outputs.${job.platform}_hash }}` }) -%>
<% } -%>
<% } -%>
<% for (const job of jobs) { -%>
  native-<%= job.platform %>:
    name: <%- yamlScalar(job.name) %>
    runs-on: <%- job.runsOn %>
    permissions:
      contents: write
    env:
<% for (const e of job.env) { -%>
      <%= e.key %>: <%- e.value %>
<% } -%>
      EXPO_UPDATES_FINGERPRINT_OVERRIDE: ${{ needs.fingerprint.outputs.<%= job.platform %>_hash }}
    needs: fingerprint
    if: needs.fingerprint.outputs.<%= job.platform %>_native_exists != 'true'
    concurrency:
      group: <%- job.concurrencyGroup %>
      cancel-in-progress: false
<% if (appDir) { -%>
    defaults:
      run:
        working-directory: <%- yamlScalar(appDir) %>
<% } -%>
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
<% if (packageManager !== 'bun') { -%>
          cache: <%= packageManager %>
<% if (appDir) { -%>
          cache-dependency-path: <%- yamlScalar(`${appDir}/${packageManager === 'npm' ? 'package-lock.json' : 'yarn.lock'}`) %>
<% } -%>
<% } -%>

<% if (packageManager === 'bun') { -%>
      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

<% } -%>
<% if (job.selfHosted) { -%>
      - name: Install Ruby dependencies
        run: bundle install

<% } else { -%>
      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.2
          bundler-cache: true
<% if (appDir) { -%>
          working-directory: <%- yamlScalar(appDir) %>
<% } -%>

<% } -%>
<% if (job.platform === 'ios' && !job.selfHosted) { -%>
      - name: Select Xcode
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable
<% } -%>
<% if (job.platform === 'android') { -%>
      - name: Setup JDK
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
<% } -%>

      - name: Install JS dependencies
        run: <%= packageManager === 'bun' ? 'bun install --frozen-lockfile' : packageManager === 'npm' ? 'npm ci' : 'yarn install --frozen-lockfile' %>

<% if (job.e2e) { -%>
<%- include(`partials/e2e-binary-${job.platform}`, { e2e: job.e2e, hashExpr: job.hashExpr, setupJava: false, restore: false }) -%>
<%- include(`partials/maestro-${job.platform}`, { e2e: job.e2e, guard: false, selfHosted: job.selfHosted }) -%>
<%- include('partials/e2e-save-step', { platform: job.platform, e2e: job.e2e, restore: false }) -%>
<% } -%>
<%- include('partials/native-recheck-step', { tagPrefix: job.tagPrefix, hashExpr: `\${{ needs.fingerprint.outputs.${job.platform}_hash }}` }) -%>
      - name: Run Fastlane lane <%= job.lane %> (<%= job.platform %>)
        if: steps.recheck.outputs.exists != 'true'
        run: bundle exec fastlane <%= job.platform %> <%= job.lane %>
        env:
<% for (const secret of job.secrets) { -%>
          <%= secret %>: ${{ secrets.<%= secret %> }}
<% } -%>
<% if (job.platform === 'ios' && job.secrets.some(s => s === 'MATCH_PASSWORD')) { -%>
          MATCH_GIT_BASIC_AUTHORIZATION: ${{ secrets.MATCH_GIT_BASIC_AUTHORIZATION }}
<% } -%>
<% if (job.platform === 'android') { -%>
          GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g"
<% } -%>

<%- include('partials/native-tag-step', { ifExpr: "steps.recheck.outputs.exists != 'true'", tagPrefix: job.tagPrefix, hashExpr: `\${{ needs.fingerprint.outputs.${job.platform}_hash }}` }) -%>
<% if (job !== jobs[jobs.length - 1]) { -%>

<% } -%>
<% } -%>
