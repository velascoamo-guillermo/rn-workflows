# Auto-generated by rn-workflows. Do not edit by hand.
# Regenerate with: npx rn-workflows generate

name: <%= workflowName %>

on:
  workflow_dispatch:
  push:
    branches: [<%= branch %>]

jobs:
<% if (hasChecks) { -%>
  quality:
    name: Quality checks
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
<% if (packageManager !== 'bun') { -%>
          cache: <%= packageManager %>
<% } -%>

<% if (packageManager === 'bun') { -%>
      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

<% } -%>
      - name: Install JS dependencies
        run: <%= packageManager === 'bun' ? 'bun install --frozen-lockfile' : packageManager === 'npm' ? 'npm ci' : 'yarn install --frozen-lockfile' %>

<% if (checks.lint) { -%>
      - name: Lint
        run: <%= packageManager === 'bun' ? 'bun expo lint' : packageManager === 'npm' ? 'npx expo lint' : 'yarn expo lint' %>

<% } -%>
<% if (checks.typecheck) { -%>
      - name: Type check
        run: <%= packageManager === 'bun' ? 'bun tsc --noEmit' : packageManager === 'npm' ? 'npx tsc --noEmit' : 'yarn tsc --noEmit' %>

<% } -%>
<% if (checks.test) { -%>
      - name: Test
        run: <%= packageManager === 'bun' ? 'bun test' : packageManager === 'npm' ? 'npm test' : 'yarn test' %>

<% } -%>
<% } -%>
  fingerprint:
    name: Compute fingerprint
    runs-on: ubuntu-latest
<% if (hasChecks) { -%>
    needs: quality
<% } -%>
    outputs:
      hash: ${{ steps.fp.outputs.hash }}
      native_exists: ${{ steps.cache-check.outputs.cache-hit }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
<% if (packageManager !== 'bun') { -%>
          cache: <%= packageManager %>
<% } -%>

<% if (packageManager === 'bun') { -%>
      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

<% } -%>
      - name: Install JS dependencies
        run: <%= packageManager === 'bun' ? 'bun install --frozen-lockfile' : packageManager === 'npm' ? 'npm ci' : 'yarn install --frozen-lockfile' %>

      - name: Compute fingerprint
        id: fp
        run: |
          HASH=$(npx --yes @expo/fingerprint . 2>/dev/null)
          echo "hash=$HASH" >> $GITHUB_OUTPUT

      - name: Check if native binary exists for this fingerprint
        id: cache-check
        uses: actions/cache@v4
        with:
          key: fingerprint-${{ steps.fp.outputs.hash }}
          path: .rn-fingerprint
          lookup-only: true

  ota-update:
    name: OTA Update
    runs-on: ubuntu-latest
    needs: fingerprint
    if: needs.fingerprint.outputs.native_exists == 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
<% if (packageManager !== 'bun') { -%>
          cache: <%= packageManager %>
<% } -%>

<% if (packageManager === 'bun') { -%>
      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

<% } -%>
      - name: Install JS dependencies
        run: <%= packageManager === 'bun' ? 'bun install --frozen-lockfile' : packageManager === 'npm' ? 'npm ci' : 'yarn install --frozen-lockfile' %>

      - name: Export JS bundle
        run: npx expo export --platform all --output-dir dist

      - name: Package bundle
        run: cd dist && zip -r ../bundle.zip .

      - name: Upload OTA update
        run: |
          curl -X POST <%= ota.server %>/api/upload \
            -F "file=@bundle.zip" \
            -F "runtimeVersion=${{ needs.fingerprint.outputs.hash }}" \
            -F "channel=<%= ota.channel %>" \
            -F "commitHash=${{ github.sha }}" \
            -F "commitMessage=${{ github.event.head_commit.message }}" \
            -F "uploadKey=${{ secrets.OTA_UPLOAD_KEY }}"

<% for (const job of jobs) { -%>
  <%= job.id %>:
    name: <%= job.name %>
    runs-on: <%= job.runsOn %>
    needs: fingerprint
    if: needs.fingerprint.outputs.native_exists != 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
<% if (packageManager !== 'bun') { -%>
          cache: <%= packageManager %>
<% } -%>

<% if (packageManager === 'bun') { -%>
      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

<% } -%>
      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.2
          bundler-cache: true

<% if (job.platform === 'ios') { -%>
      - name: Select Xcode
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable
<% } -%>
<% if (job.platform === 'android') { -%>
      - name: Setup JDK
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
<% } -%>

      - name: Install JS dependencies
        run: <%= packageManager === 'bun' ? 'bun install --frozen-lockfile' : packageManager === 'npm' ? 'npm ci' : 'yarn install --frozen-lockfile' %>

<% if (job.platform === 'ios') { -%>
      - name: Expo Prebuild (iOS)
        run: npx expo prebuild --platform ios --no-install

      - name: Install Pods
        run: cd ios && pod install --repo-update

<% } -%>
<% if (job.platform === 'android') { -%>
      - name: Expo Prebuild (Android)
        run: npx expo prebuild --platform android --no-install

<% } -%>
      - name: Run Fastlane lane <%= job.lane %> (<%= job.platform %>)
        run: bundle exec fastlane <%= job.platform %> <%= job.lane %>
        env:
<% for (const secret of job.secrets) { -%>
          <%= secret %>: ${{ secrets.<%= secret %> }}
<% } -%>
<% if (job.platform === 'ios' && job.secrets.some(s => s === 'MATCH_PASSWORD')) { -%>
          MATCH_GIT_BASIC_AUTHORIZATION: ${{ secrets.MATCH_GIT_BASIC_AUTHORIZATION }}
<% } -%>
<% if (job.platform === 'android') { -%>
          GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g"
<% } -%>

<% } -%>
  save-fingerprint:
    name: Save fingerprint cache
    runs-on: ubuntu-latest
    needs: [fingerprint<% for (const job of jobs) { -%>, <%= job.id -%><% } %>]
    if: |
      always() &&
      needs.fingerprint.outputs.native_exists != 'true' &&
      !contains(needs.*.result, 'failure') &&
      !contains(needs.*.result, 'cancelled')
    steps:
      - name: Create marker file
        run: mkdir -p .rn-fingerprint && echo "${{ needs.fingerprint.outputs.hash }}" > .rn-fingerprint/hash

      - name: Save fingerprint to cache
        uses: actions/cache/save@v4
        with:
          key: fingerprint-${{ needs.fingerprint.outputs.hash }}
          path: .rn-fingerprint
