// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`Fastfile snapshot matches the committed Fastfile for an expo production config 1`] = `
"# Auto-generated by rn-workflows. Do not edit by hand.
# Regenerate with: npx rn-workflows generate

default_platform(:android)

before_all do
  if ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_CONTENT"]
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: ENV["ASC_KEY_IS_BASE64"] == "true",
      in_house: false
    )
  end
end

platform :android do
  desc "Build production (android)"
  lane :production do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/"
    )
    upload_to_play_store(
      json_key_data: ENV["PLAY_STORE_JSON_KEY"],
      package_name: "com.gvelasco.pawlog",
      track: "production",
      aab: "android/app/build/outputs/bundle/release/app-release.aab"
    )
  end
end

platform :ios do
  desc "Build production (ios)"
  lane :production do
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: ENV.fetch("MATCH_READONLY", "true") == "true") if ENV["MATCH_PASSWORD"]
    build_app(
      workspace: "ios/Pawlog.xcworkspace",
      scheme: "Pawlog",
      export_method: "app-store",
      output_directory: "ios/build",
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='match AppStore com.gvelasco.pawlog' CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          "com.gvelasco.pawlog" => "match AppStore com.gvelasco.pawlog"
        }
      }
    )
    upload_to_app_store(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      force: true,
      skip_metadata: true,
      skip_screenshots: true
    )
  end
end

platform :ios do
  lane :add_device do |options|
    name = options[:name] || UI.input("Device name:")
    udid = options[:udid] || UI.input("Device UDID:")
    register_devices(devices: { name => udid })
    require 'spaceship'
    Spaceship::ConnectAPI::Device.enable(udid)
    match(type: "adhoc", force_for_new_devices: true)
  end

  lane :list_devices do
    require 'spaceship'
    devices = Spaceship::ConnectAPI::Device.all
    UI.message "\\n📱 Registered devices (#{devices.count}):"
    devices.each do |d|
      UI.message "  #{d.name.to_s.ljust(30)} #{d.udid}  [#{d.platform}] #{d.status}"
    end
  end

  lane :regenerate_certs do
    match(type: "adhoc", force: true)
  end

  lane :remove_device do |options|
    udid = options[:udid] || UI.input("Device UDID to disable:")
    require 'spaceship'
    device = Spaceship::ConnectAPI::Device.all.find { |d| d.udid == udid }
    if device
      Spaceship::ConnectAPI::Device.disable(device.udid)
      UI.success("Disabled #{device.name} (#{udid})")
    else
      UI.error("Device with UDID #{udid} not found")
    end
  end
end

"
`;
