// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`generateGithubActions with OTA output matches snapshot 1`] = `
"# Auto-generated by rn-workflows. Do not edit by hand.
# Regenerate with: npx rn-workflows generate

name: rn-workflows • production

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  fingerprint:
    name: Compute fingerprint
    runs-on: ubuntu-latest
    outputs:
      hash: \${{ steps.fp.outputs.hash }}
      native_exists: \${{ steps.cache-check.outputs.cache-hit }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: yarn

      - name: Install JS dependencies
        run: yarn install --frozen-lockfile

      - name: Compute fingerprint
        id: fp
        run: |
          HASH=$(npx --yes @expo/fingerprint . 2>/dev/null)
          echo "hash=$HASH" >> $GITHUB_OUTPUT

      - name: Check if native binary exists for this fingerprint
        id: cache-check
        uses: actions/cache@v4
        with:
          key: fingerprint-\${{ steps.fp.outputs.hash }}
          path: .rn-fingerprint
          lookup-only: true

  ota-update:
    name: OTA Update
    runs-on: ubuntu-latest
    needs: fingerprint
    if: needs.fingerprint.outputs.native_exists == 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: yarn

      - name: Install JS dependencies
        run: yarn install --frozen-lockfile

      - name: Export JS bundle
        run: npx expo export --platform all --output-dir dist

      - name: Package bundle
        run: cd dist && zip -r ../bundle.zip .

      - name: Upload OTA update
        run: |
          curl -X POST https://ota.myapp.com/api/upload \\
            -F "file=@bundle.zip" \\
            -F "runtimeVersion=\${{ needs.fingerprint.outputs.hash }}" \\
            -F "channel=production" \\
            -F "commitHash=\${{ github.sha }}" \\
            -F "commitMessage=\${{ github.event.head_commit.message }}" \\
            -F "uploadKey=\${{ secrets.OTA_UPLOAD_KEY }}"

  build-android:
    name: Build production (android)
    runs-on: ubuntu-latest
    needs: fingerprint
    if: needs.fingerprint.outputs.native_exists != 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: yarn

      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.2
          bundler-cache: true

      - name: Setup JDK
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Install JS dependencies
        run: yarn install --frozen-lockfile

      - name: Expo Prebuild (Android)
        run: npx expo prebuild --platform android --no-install

      - name: Run Fastlane lane production (android)
        run: bundle exec fastlane android production
        env:
          PLAY_STORE_JSON_KEY: \${{ secrets.PLAY_STORE_JSON_KEY }}
          GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g"

  build-ios:
    name: Build production (ios)
    runs-on: macos-latest
    needs: fingerprint
    if: needs.fingerprint.outputs.native_exists != 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: yarn

      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.2
          bundler-cache: true

      - name: Select Xcode
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

      - name: Install JS dependencies
        run: yarn install --frozen-lockfile

      - name: Expo Prebuild (iOS)
        run: npx expo prebuild --platform ios --no-install

      - name: Install Pods
        run: cd ios && pod install --repo-update

      - name: Run Fastlane lane production (ios)
        run: bundle exec fastlane ios production
        env:
          APPLE_TEAM_ID: \${{ secrets.APPLE_TEAM_ID }}
          APP_STORE_CONNECT_API_KEY_PATH: \${{ secrets.APP_STORE_CONNECT_API_KEY_PATH }}
          MATCH_GIT_URL: \${{ secrets.MATCH_GIT_URL }}
          MATCH_PASSWORD: \${{ secrets.MATCH_PASSWORD }}
          MATCH_GIT_BASIC_AUTHORIZATION: \${{ secrets.MATCH_GIT_BASIC_AUTHORIZATION }}

  save-fingerprint:
    name: Save fingerprint cache
    runs-on: ubuntu-latest
    needs: [fingerprint, build-android, build-ios]
    if: |
      always() &&
      needs.fingerprint.outputs.native_exists != 'true' &&
      !contains(needs.*.result, 'failure') &&
      !contains(needs.*.result, 'cancelled')
    steps:
      - name: Create marker file
        run: mkdir -p .rn-fingerprint && echo "\${{ needs.fingerprint.outputs.hash }}" > .rn-fingerprint/hash

      - name: Save fingerprint to cache
        uses: actions/cache/save@v4
        with:
          key: fingerprint-\${{ needs.fingerprint.outputs.hash }}
          path: .rn-fingerprint
"
`;
