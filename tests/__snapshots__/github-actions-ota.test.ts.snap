// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`smart (OTA) workflow shape output matches snapshot 1`] = `
"# Auto-generated by rn-workflows. Do not edit by hand.
# Regenerate with: npx rn-workflows generate

name: rn-workflows • production

on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  fingerprint:
    name: Compute fingerprint
    runs-on: ubuntu-latest
    outputs:
      android_hash: \${{ steps.fp-android.outputs.hash }}
      android_native_exists: \${{ steps.native-android.outputs.exists }}
      ios_hash: \${{ steps.fp-ios.outputs.hash }}
      ios_native_exists: \${{ steps.native-ios.outputs.exists }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: yarn

      - name: Install JS dependencies
        run: yarn install --frozen-lockfile

      - name: Resolve runtimeVersion (android)
        id: fp-android
        env:
          RNW_PLATFORM: android
        run: |
          set -euo pipefail
          HASH=$(node "$(node -p "require.resolve('expo-updates/bin/cli.js')")" runtimeversion:resolve --platform "$RNW_PLATFORM" | tail -n1 | jq -er '.runtimeVersion')
          SAFE='^[A-Za-z0-9._-]+$'
          if [[ ! "$HASH" =~ $SAFE ]]; then
            echo "::error::runtimeVersion for $RNW_PLATFORM is missing or unsafe; set runtimeVersion: { policy: \\"fingerprint\\" } in app config"
            exit 1
          fi
          echo "hash=$HASH" >> "$GITHUB_OUTPUT"

      - name: Check native release tag (android)
        id: native-android
        env:
          RNW_TAG_PREFIX: rnw/native/production/android
          RNW_HASH: \${{ steps.fp-android.outputs.hash }}
        run: |
          set -euo pipefail
          rc=0
          git ls-remote --exit-code --tags origin "refs/tags/$RNW_TAG_PREFIX/$RNW_HASH" > /dev/null || rc=$?
          case "$rc" in
            0) echo "exists=true" >> "$GITHUB_OUTPUT" ;;
            2) echo "exists=false" >> "$GITHUB_OUTPUT" ;;
            *) echo "::error::git ls-remote origin failed (exit $rc)"; exit "$rc" ;;
          esac

      - name: Resolve runtimeVersion (ios)
        id: fp-ios
        env:
          RNW_PLATFORM: ios
        run: |
          set -euo pipefail
          HASH=$(node "$(node -p "require.resolve('expo-updates/bin/cli.js')")" runtimeversion:resolve --platform "$RNW_PLATFORM" | tail -n1 | jq -er '.runtimeVersion')
          SAFE='^[A-Za-z0-9._-]+$'
          if [[ ! "$HASH" =~ $SAFE ]]; then
            echo "::error::runtimeVersion for $RNW_PLATFORM is missing or unsafe; set runtimeVersion: { policy: \\"fingerprint\\" } in app config"
            exit 1
          fi
          echo "hash=$HASH" >> "$GITHUB_OUTPUT"

      - name: Check native release tag (ios)
        id: native-ios
        env:
          RNW_TAG_PREFIX: rnw/native/production/ios
          RNW_HASH: \${{ steps.fp-ios.outputs.hash }}
        run: |
          set -euo pipefail
          rc=0
          git ls-remote --exit-code --tags origin "refs/tags/$RNW_TAG_PREFIX/$RNW_HASH" > /dev/null || rc=$?
          case "$rc" in
            0) echo "exists=true" >> "$GITHUB_OUTPUT" ;;
            2) echo "exists=false" >> "$GITHUB_OUTPUT" ;;
            *) echo "::error::git ls-remote origin failed (exit $rc)"; exit "$rc" ;;
          esac

  ota-android:
    name: OTA update production (android)
    runs-on: ubuntu-latest
    needs: fingerprint
    if: needs.fingerprint.outputs.android_native_exists == 'true'
    concurrency:
      group: rnw-production-android
      cancel-in-progress: false
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: yarn

      - name: Install JS dependencies
        run: yarn install --frozen-lockfile

      - name: Export JS bundle (android)
        id: export
        env:
          RNW_PLATFORM: android
        run: yarn expo export --platform "$RNW_PLATFORM" --output-dir dist

      - name: Package bundle
        id: package
        run: |
          set -euo pipefail
          yarn expo config --type public --json > dist/expoconfig.json
          jq -e . dist/expoconfig.json > /dev/null
          rm -f bundle.zip
          (cd dist && zip -qr ../bundle.zip .)

      - name: Compute update id
        id: update-id
        run: |
          set -euo pipefail
          UPDATE_ID=$(node -e 'const h = require("crypto").createHash("sha256").update(require("fs").readFileSync("dist/metadata.json")).digest("hex"); console.log([h.slice(0, 8), h.slice(8, 12), h.slice(12, 16), h.slice(16, 20), h.slice(20, 32)].join("-"))')
          echo "update_id=$UPDATE_ID" >> "$GITHUB_OUTPUT"

      - name: Upload OTA update
        id: upload
        env:
          RNW_OTA_SERVER: 'https://ota.myapp.com'
          RNW_CHANNEL: production
          RNW_HASH: \${{ needs.fingerprint.outputs.android_hash }}
          RNW_COMMIT_MESSAGE: \${{ github.event.head_commit.message }}
          OTA_UPLOAD_KEY: \${{ secrets.OTA_UPLOAD_KEY }}
        run: |
          set -euo pipefail
          curl --fail-with-body -sS -X POST "$RNW_OTA_SERVER/api/upload" \\
            -F "file=@bundle.zip" \\
            --form-string "runtimeVersion=$RNW_HASH" \\
            --form-string "channel=$RNW_CHANNEL" \\
            --form-string "commitHash=$GITHUB_SHA" \\
            --form-string "commitMessage=$RNW_COMMIT_MESSAGE" \\
            --form-string "uploadKey=$OTA_UPLOAD_KEY"

  ota-ios:
    name: OTA update production (ios)
    runs-on: macos-latest
    needs: fingerprint
    if: needs.fingerprint.outputs.ios_native_exists == 'true'
    concurrency:
      group: rnw-production-ios
      cancel-in-progress: false
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: yarn

      - name: Install JS dependencies
        run: yarn install --frozen-lockfile

      - name: Export JS bundle (ios)
        id: export
        env:
          RNW_PLATFORM: ios
        run: yarn expo export --platform "$RNW_PLATFORM" --output-dir dist

      - name: Package bundle
        id: package
        run: |
          set -euo pipefail
          yarn expo config --type public --json > dist/expoconfig.json
          jq -e . dist/expoconfig.json > /dev/null
          rm -f bundle.zip
          (cd dist && zip -qr ../bundle.zip .)

      - name: Compute update id
        id: update-id
        run: |
          set -euo pipefail
          UPDATE_ID=$(node -e 'const h = require("crypto").createHash("sha256").update(require("fs").readFileSync("dist/metadata.json")).digest("hex"); console.log([h.slice(0, 8), h.slice(8, 12), h.slice(12, 16), h.slice(16, 20), h.slice(20, 32)].join("-"))')
          echo "update_id=$UPDATE_ID" >> "$GITHUB_OUTPUT"

      - name: Upload OTA update
        id: upload
        env:
          RNW_OTA_SERVER: 'https://ota.myapp.com'
          RNW_CHANNEL: production
          RNW_HASH: \${{ needs.fingerprint.outputs.ios_hash }}
          RNW_COMMIT_MESSAGE: \${{ github.event.head_commit.message }}
          OTA_UPLOAD_KEY: \${{ secrets.OTA_UPLOAD_KEY }}
        run: |
          set -euo pipefail
          curl --fail-with-body -sS -X POST "$RNW_OTA_SERVER/api/upload" \\
            -F "file=@bundle.zip" \\
            --form-string "runtimeVersion=$RNW_HASH" \\
            --form-string "channel=$RNW_CHANNEL" \\
            --form-string "commitHash=$GITHUB_SHA" \\
            --form-string "commitMessage=$RNW_COMMIT_MESSAGE" \\
            --form-string "uploadKey=$OTA_UPLOAD_KEY"

  native-android:
    name: Build production (android)
    runs-on: ubuntu-latest
    permissions:
      contents: write
    env:
      EXPO_UPDATES_FINGERPRINT_OVERRIDE: \${{ needs.fingerprint.outputs.android_hash }}
    needs: fingerprint
    if: needs.fingerprint.outputs.android_native_exists != 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: yarn

      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.2
          bundler-cache: true

      - name: Setup JDK
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Install JS dependencies
        run: yarn install --frozen-lockfile

      - name: Run Fastlane lane production (android)
        run: bundle exec fastlane android production
        env:
          PLAY_STORE_JSON_KEY: \${{ secrets.PLAY_STORE_JSON_KEY }}
          GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g"

      - name: Tag native release
        id: tag
        env:
          RNW_TAG_PREFIX: rnw/native/production/android
          RNW_HASH: \${{ needs.fingerprint.outputs.android_hash }}
        run: git tag "$RNW_TAG_PREFIX/$RNW_HASH" && git push origin "refs/tags/$RNW_TAG_PREFIX/$RNW_HASH"

  native-ios:
    name: Build production (ios)
    runs-on: macos-latest
    permissions:
      contents: write
    env:
      EXPO_UPDATES_FINGERPRINT_OVERRIDE: \${{ needs.fingerprint.outputs.ios_hash }}
    needs: fingerprint
    if: needs.fingerprint.outputs.ios_native_exists != 'true'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: yarn

      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.2
          bundler-cache: true

      - name: Select Xcode
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

      - name: Install JS dependencies
        run: yarn install --frozen-lockfile

      - name: Run Fastlane lane production (ios)
        run: bundle exec fastlane ios production
        env:
          APPLE_TEAM_ID: \${{ secrets.APPLE_TEAM_ID }}
          ASC_ISSUER_ID: \${{ secrets.ASC_ISSUER_ID }}
          ASC_KEY_CONTENT: \${{ secrets.ASC_KEY_CONTENT }}
          ASC_KEY_ID: \${{ secrets.ASC_KEY_ID }}
          ASC_KEY_IS_BASE64: \${{ secrets.ASC_KEY_IS_BASE64 }}
          MATCH_GIT_URL: \${{ secrets.MATCH_GIT_URL }}
          MATCH_PASSWORD: \${{ secrets.MATCH_PASSWORD }}
          MATCH_GIT_BASIC_AUTHORIZATION: \${{ secrets.MATCH_GIT_BASIC_AUTHORIZATION }}

      - name: Tag native release
        id: tag
        env:
          RNW_TAG_PREFIX: rnw/native/production/ios
          RNW_HASH: \${{ needs.fingerprint.outputs.ios_hash }}
        run: git tag "$RNW_TAG_PREFIX/$RNW_HASH" && git push origin "refs/tags/$RNW_TAG_PREFIX/$RNW_HASH"
"
`;
