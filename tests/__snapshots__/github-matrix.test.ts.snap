// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`matrix output for non-ota apps is byte-identical bun, two apps (store all + firebase android) 1`] = `
"# Auto-generated by rn-workflows. Do not edit by hand.
# Regenerate with: npx rn-workflows generate --matrix
#
# One matrix workflow for every app in this monorepo. Deliberately NOT
# triggered by on.push.paths: a path filter cannot scope matrix legs, so any
# app's change would rebuild all apps. Release via tag push or dispatch.

name: rn-workflows • release matrix

on:
  workflow_dispatch:
    inputs:
      app:
        description: Only run for this app slug (empty = all apps)
        type: string
        required: false
        default: ''
  push:
    tags:
      - 'v*'

jobs:
  plan:
    name: Plan matrix
    runs-on: ubuntu-latest
    env:
      QUALITY_LEGS: "[{\\"app\\":\\"pawlog\\",\\"dir\\":\\"apps/pawlog\\",\\"lint\\":false,\\"typecheck\\":true,\\"test\\":true}]"
      RELEASE_LEGS: "[{\\"app\\":\\"pawlog\\",\\"dir\\":\\"apps/pawlog\\",\\"profile\\":\\"production\\",\\"platform\\":\\"android\\",\\"runsOn\\":\\"ubuntu-latest\\",\\"ota\\":false,\\"otaUpload\\":false,\\"otaServer\\":\\"\\",\\"otaChannel\\":\\"\\"},{\\"app\\":\\"pawlog\\",\\"dir\\":\\"apps/pawlog\\",\\"profile\\":\\"production\\",\\"platform\\":\\"ios\\",\\"runsOn\\":\\"macos-latest\\",\\"ota\\":false,\\"otaUpload\\":false,\\"otaServer\\":\\"\\",\\"otaChannel\\":\\"\\"},{\\"app\\":\\"vaulty\\",\\"dir\\":\\"apps/vaulty\\",\\"profile\\":\\"preview\\",\\"platform\\":\\"android\\",\\"runsOn\\":\\"ubuntu-latest\\",\\"ota\\":false,\\"otaUpload\\":false,\\"otaServer\\":\\"\\",\\"otaChannel\\":\\"\\"}]"
      APP_FILTER: \${{ inputs.app || '' }}
    outputs:
      quality: \${{ steps.plan.outputs.quality }}
      release: \${{ steps.plan.outputs.release }}
    steps:
      - name: Filter matrix legs by app input
        id: plan
        run: |
          if [ -n "$APP_FILTER" ]; then
            QUALITY=$(echo "$QUALITY_LEGS" | jq -c --arg app "$APP_FILTER" '[.[] | select(.app == $app)]')
            RELEASE=$(echo "$RELEASE_LEGS" | jq -c --arg app "$APP_FILTER" '[.[] | select(.app == $app)]')
          else
            QUALITY=$(echo "$QUALITY_LEGS" | jq -c .)
            RELEASE=$(echo "$RELEASE_LEGS" | jq -c .)
          fi
          echo "quality=$QUALITY" >> "$GITHUB_OUTPUT"
          echo "release=$RELEASE" >> "$GITHUB_OUTPUT"

  quality:
    name: Quality (\${{ matrix.app }})
    needs: plan
    if: \${{ needs.plan.outputs.quality != '[]' }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include: \${{ fromJSON(needs.plan.outputs.quality) }}
    defaults:
      run:
        working-directory: \${{ matrix.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

      - name: Install JS dependencies
        run: bun install --frozen-lockfile

      - name: Lint
        if: \${{ matrix.lint }}
        run: bun expo lint

      - name: Type check
        if: \${{ matrix.typecheck }}
        run: bun tsc --noEmit

      - name: Test
        if: \${{ matrix.test }}
        run: bun test

  release:
    name: Release \${{ matrix.app }} \${{ matrix.profile }} (\${{ matrix.platform }})
    needs: [plan, quality]
    if: \${{ !failure() && !cancelled() && needs.plan.outputs.release != '[]' }}
    runs-on: \${{ matrix.runsOn }}
    strategy:
      fail-fast: false
      matrix:
        include: \${{ fromJSON(needs.plan.outputs.release) }}
    defaults:
      run:
        working-directory: \${{ matrix.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

      - name: Install JS dependencies
        run: bun install --frozen-lockfile

      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.2
          bundler-cache: true
          working-directory: \${{ matrix.dir }}

      - name: Select Xcode
        if: \${{ matrix.platform == 'ios' }}
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

      - name: Setup JDK
        if: \${{ matrix.platform == 'android' }}
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Run Fastlane lane
        run: bundle exec fastlane \${{ matrix.platform }} \${{ matrix.profile }}
        env:
          APPLE_TEAM_ID: \${{ secrets.APPLE_TEAM_ID }}
          ASC_ISSUER_ID: \${{ secrets.ASC_ISSUER_ID }}
          ASC_KEY_CONTENT: \${{ secrets.ASC_KEY_CONTENT }}
          ASC_KEY_ID: \${{ secrets.ASC_KEY_ID }}
          ASC_KEY_IS_BASE64: \${{ secrets.ASC_KEY_IS_BASE64 }}
          FIREBASE_APP_ID_ANDROID: \${{ secrets.FIREBASE_APP_ID_ANDROID }}
          FIREBASE_SERVICE_ACCOUNT_JSON: \${{ secrets.FIREBASE_SERVICE_ACCOUNT_JSON }}
          MATCH_GIT_URL: \${{ secrets.MATCH_GIT_URL }}
          MATCH_PASSWORD: \${{ secrets.MATCH_PASSWORD }}
          PLAY_STORE_JSON_KEY: \${{ secrets.PLAY_STORE_JSON_KEY }}
          MATCH_GIT_BASIC_AUTHORIZATION: \${{ secrets.MATCH_GIT_BASIC_AUTHORIZATION }}
          GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g"
"
`;

exports[`matrix output for non-ota apps is byte-identical yarn default, self-hosted ios runner + root-level app 1`] = `
"# Auto-generated by rn-workflows. Do not edit by hand.
# Regenerate with: npx rn-workflows generate --matrix
#
# One matrix workflow for every app in this monorepo. Deliberately NOT
# triggered by on.push.paths: a path filter cannot scope matrix legs, so any
# app's change would rebuild all apps. Release via tag push or dispatch.

name: rn-workflows • release matrix

on:
  workflow_dispatch:
    inputs:
      app:
        description: Only run for this app slug (empty = all apps)
        type: string
        required: false
        default: ''
  push:
    tags:
      - 'v*'

jobs:
  plan:
    name: Plan matrix
    runs-on: ubuntu-latest
    env:
      QUALITY_LEGS: "[{\\"app\\":\\"nightly\\",\\"dir\\":\\".\\",\\"lint\\":true,\\"typecheck\\":false,\\"test\\":false}]"
      RELEASE_LEGS: "[{\\"app\\":\\"nightly\\",\\"dir\\":\\".\\",\\"profile\\":\\"production\\",\\"platform\\":\\"android\\",\\"runsOn\\":\\"ubuntu-latest\\",\\"selfHosted\\":false,\\"ota\\":false,\\"otaUpload\\":false,\\"otaServer\\":\\"\\",\\"otaChannel\\":\\"\\"},{\\"app\\":\\"nightly\\",\\"dir\\":\\".\\",\\"profile\\":\\"production\\",\\"platform\\":\\"ios\\",\\"runsOn\\":[\\"self-hosted\\",\\"macos-arm\\"],\\"selfHosted\\":true,\\"ota\\":false,\\"otaUpload\\":false,\\"otaServer\\":\\"\\",\\"otaChannel\\":\\"\\"},{\\"app\\":\\"vaulty\\",\\"dir\\":\\"apps/vaulty\\",\\"profile\\":\\"preview\\",\\"platform\\":\\"android\\",\\"runsOn\\":\\"ubuntu-latest\\",\\"selfHosted\\":false,\\"ota\\":false,\\"otaUpload\\":false,\\"otaServer\\":\\"\\",\\"otaChannel\\":\\"\\"}]"
      APP_FILTER: \${{ inputs.app || '' }}
    outputs:
      quality: \${{ steps.plan.outputs.quality }}
      release: \${{ steps.plan.outputs.release }}
    steps:
      - name: Filter matrix legs by app input
        id: plan
        run: |
          if [ -n "$APP_FILTER" ]; then
            QUALITY=$(echo "$QUALITY_LEGS" | jq -c --arg app "$APP_FILTER" '[.[] | select(.app == $app)]')
            RELEASE=$(echo "$RELEASE_LEGS" | jq -c --arg app "$APP_FILTER" '[.[] | select(.app == $app)]')
          else
            QUALITY=$(echo "$QUALITY_LEGS" | jq -c .)
            RELEASE=$(echo "$RELEASE_LEGS" | jq -c .)
          fi
          echo "quality=$QUALITY" >> "$GITHUB_OUTPUT"
          echo "release=$RELEASE" >> "$GITHUB_OUTPUT"

  quality:
    name: Quality (\${{ matrix.app }})
    needs: plan
    if: \${{ needs.plan.outputs.quality != '[]' }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include: \${{ fromJSON(needs.plan.outputs.quality) }}
    defaults:
      run:
        working-directory: \${{ matrix.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: yarn

      - name: Install JS dependencies
        run: yarn install --frozen-lockfile

      - name: Lint
        if: \${{ matrix.lint }}
        run: yarn expo lint

      - name: Type check
        if: \${{ matrix.typecheck }}
        run: yarn tsc --noEmit

      - name: Test
        if: \${{ matrix.test }}
        run: yarn test

  release:
    name: Release \${{ matrix.app }} \${{ matrix.profile }} (\${{ matrix.platform }})
    needs: [plan, quality]
    if: \${{ !failure() && !cancelled() && needs.plan.outputs.release != '[]' }}
    runs-on: \${{ matrix.runsOn }}
    strategy:
      fail-fast: false
      matrix:
        include: \${{ fromJSON(needs.plan.outputs.release) }}
    defaults:
      run:
        working-directory: \${{ matrix.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: yarn

      - name: Install JS dependencies
        run: yarn install --frozen-lockfile

      - name: Install Ruby dependencies
        if: \${{ matrix.selfHosted }}
        run: bundle install

      - name: Setup Ruby
        if: \${{ !matrix.selfHosted }}
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.2
          bundler-cache: true
          working-directory: \${{ matrix.dir }}

      - name: Select Xcode
        if: \${{ matrix.platform == 'ios' && !matrix.selfHosted }}
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

      - name: Setup JDK
        if: \${{ matrix.platform == 'android' }}
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Run Fastlane lane
        run: bundle exec fastlane \${{ matrix.platform }} \${{ matrix.profile }}
        env:
          APPLE_TEAM_ID: \${{ secrets.APPLE_TEAM_ID }}
          ASC_ISSUER_ID: \${{ secrets.ASC_ISSUER_ID }}
          ASC_KEY_CONTENT: \${{ secrets.ASC_KEY_CONTENT }}
          ASC_KEY_ID: \${{ secrets.ASC_KEY_ID }}
          ASC_KEY_IS_BASE64: \${{ secrets.ASC_KEY_IS_BASE64 }}
          FIREBASE_APP_ID_ANDROID: \${{ secrets.FIREBASE_APP_ID_ANDROID }}
          FIREBASE_SERVICE_ACCOUNT_JSON: \${{ secrets.FIREBASE_SERVICE_ACCOUNT_JSON }}
          MATCH_GIT_URL: \${{ secrets.MATCH_GIT_URL }}
          MATCH_PASSWORD: \${{ secrets.MATCH_PASSWORD }}
          PLAY_STORE_JSON_KEY: \${{ secrets.PLAY_STORE_JSON_KEY }}
          MATCH_GIT_BASIC_AUTHORIZATION: \${{ secrets.MATCH_GIT_BASIC_AUTHORIZATION }}
          GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g"
"
`;

exports[`matrix output for non-ota apps is byte-identical npm, single android app without checks 1`] = `
"# Auto-generated by rn-workflows. Do not edit by hand.
# Regenerate with: npx rn-workflows generate --matrix
#
# One matrix workflow for every app in this monorepo. Deliberately NOT
# triggered by on.push.paths: a path filter cannot scope matrix legs, so any
# app's change would rebuild all apps. Release via tag push or dispatch.

name: rn-workflows • release matrix

on:
  workflow_dispatch:
    inputs:
      app:
        description: Only run for this app slug (empty = all apps)
        type: string
        required: false
        default: ''
  push:
    tags:
      - 'v*'

jobs:
  plan:
    name: Plan matrix
    runs-on: ubuntu-latest
    env:
      QUALITY_LEGS: "[]"
      RELEASE_LEGS: "[{\\"app\\":\\"vaulty\\",\\"dir\\":\\"apps/vaulty\\",\\"profile\\":\\"preview\\",\\"platform\\":\\"android\\",\\"runsOn\\":\\"ubuntu-latest\\",\\"ota\\":false,\\"otaUpload\\":false,\\"otaServer\\":\\"\\",\\"otaChannel\\":\\"\\"}]"
      APP_FILTER: \${{ inputs.app || '' }}
    outputs:
      quality: \${{ steps.plan.outputs.quality }}
      release: \${{ steps.plan.outputs.release }}
    steps:
      - name: Filter matrix legs by app input
        id: plan
        run: |
          if [ -n "$APP_FILTER" ]; then
            QUALITY=$(echo "$QUALITY_LEGS" | jq -c --arg app "$APP_FILTER" '[.[] | select(.app == $app)]')
            RELEASE=$(echo "$RELEASE_LEGS" | jq -c --arg app "$APP_FILTER" '[.[] | select(.app == $app)]')
          else
            QUALITY=$(echo "$QUALITY_LEGS" | jq -c .)
            RELEASE=$(echo "$RELEASE_LEGS" | jq -c .)
          fi
          echo "quality=$QUALITY" >> "$GITHUB_OUTPUT"
          echo "release=$RELEASE" >> "$GITHUB_OUTPUT"

  quality:
    name: Quality (\${{ matrix.app }})
    needs: plan
    if: \${{ needs.plan.outputs.quality != '[]' }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include: \${{ fromJSON(needs.plan.outputs.quality) }}
    defaults:
      run:
        working-directory: \${{ matrix.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install JS dependencies
        run: npm ci

      - name: Lint
        if: \${{ matrix.lint }}
        run: npx expo lint

      - name: Type check
        if: \${{ matrix.typecheck }}
        run: npx tsc --noEmit

      - name: Test
        if: \${{ matrix.test }}
        run: npm test

  release:
    name: Release \${{ matrix.app }} \${{ matrix.profile }} (\${{ matrix.platform }})
    needs: [plan, quality]
    if: \${{ !failure() && !cancelled() && needs.plan.outputs.release != '[]' }}
    runs-on: \${{ matrix.runsOn }}
    strategy:
      fail-fast: false
      matrix:
        include: \${{ fromJSON(needs.plan.outputs.release) }}
    defaults:
      run:
        working-directory: \${{ matrix.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install JS dependencies
        run: npm ci

      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: 3.2
          bundler-cache: true
          working-directory: \${{ matrix.dir }}

      - name: Select Xcode
        if: \${{ matrix.platform == 'ios' }}
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

      - name: Setup JDK
        if: \${{ matrix.platform == 'android' }}
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Run Fastlane lane
        run: bundle exec fastlane \${{ matrix.platform }} \${{ matrix.profile }}
        env:
          FIREBASE_APP_ID_ANDROID: \${{ secrets.FIREBASE_APP_ID_ANDROID }}
          FIREBASE_SERVICE_ACCOUNT_JSON: \${{ secrets.FIREBASE_SERVICE_ACCOUNT_JSON }}
          GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g"
"
`;
